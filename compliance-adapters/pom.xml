<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>sg.edu.rp.sandbox</groupId>
        <artifactId>digital-bank-sandbox</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>compliance-adapters</artifactId>
    <name>compliance-adapters</name>
    <description>Simulated implementations of the KYC and AML adapters (deterministic + configurable)</description>

    <!--
      Holds the SIMULATED providers that back the common adapter interfaces.
      Each is gated by @ConditionalOnProperty so a future vendor implementation
      can replace it via config. This module is auto-configured, so any service
      that depends on it picks up the simulated beans automatically.
    -->

    <dependencies>
        <dependency>
            <groupId>sg.edu.rp.sandbox</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- Needed for @Component/@ConditionalOnProperty/@ConfigurationProperties and autoconfig -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
